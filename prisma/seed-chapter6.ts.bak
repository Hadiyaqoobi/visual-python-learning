    """Age must be between 0 and 120"""
    return 0 <= age <= 120

# Boundary tests
tests = [
    (-1, False),   # Just below lower
    (0, True),     # Lower boundary
    (1, True),     # Just above lower
    (119, True),   # Just below upper
    (120, True),   # Upper boundary
    (121, False),  # Just above upper
]

for age, expected in tests:
    result = is_valid_age(age)
    status = "✓" if result == expected else "✗"
    print(f"{status} is_valid_age({age}) = {result}")`,
