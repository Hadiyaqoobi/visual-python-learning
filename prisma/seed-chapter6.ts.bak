    if score >= 90:
        return 'A'
    elif score >= 80:
        return 'B'
    elif score >= 70:
        return 'C'
    else:
        return 'F'

# Glass-box: test each branch
tests = [
    (95, 'A'),  # First branch
    (85, 'B'),  # Second branch
    (75, 'C'),  # Third branch
    (65, 'F'),  # Else branch
]

for score, expected in tests:
