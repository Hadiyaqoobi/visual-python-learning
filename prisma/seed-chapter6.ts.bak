  // ==================== LESSON 6.3.1: Assertions ====================
  const lesson6_3_1 = await prisma.lesson.upsert({
    where: { slug: "assertions" },
    update: {},
    create: {
      sectionId: section6_3.id,
      number: 6.31,
      title: "Assertions and Defensive Programming",
      slug: "assertions",
      objectives: [
        "Use assert statements effectively",
        "Check preconditions and postconditions",
        "Practice defensive programming",
        "Know when to use assertions vs exceptions",
      ],
      content: `# Assertions and Defensive Programming

**Assertions** are sanity checks that verify your assumptions about the code.

## The assert Statement

\`\`\`python
assert condition, "Error message if condition is False"
\`\`\`

If condition is False, program stops with AssertionError.

\`\`\`python
def divide(a, b):
    assert b != 0, "Cannot divide by zero"
    return a / b
\`\`\`

## Types of Assertions

### Preconditions
What must be true BEFORE the function runs:
\`\`\`python
def sqrt(x):
    assert x >= 0, "sqrt requires non-negative input"
    # ... calculate square root
\`\`\`

### Postconditions
What must be true AFTER the function runs:
\`\`\`python
def absolute_value(x):
    if x < 0:
        result = -x
    else:
        result = x
    assert result >= 0, "Result must be non-negative"
    return result
\`\`\`

### Invariants
What must ALWAYS be true:
\`\`\`python
def binary_search(lst, target):
    low, high = 0, len(lst) - 1
    while low <= high:
        assert low >= 0 and high < len(lst), "Indices out of bounds"
        # ... search logic
\`\`\`

## Defensive Programming

Write code that catches errors early:

1. **Validate inputs**: Check parameters at function start
2. **Check assumptions**: Assert things you believe to be true
3. **Fail fast**: Better to crash early than corrupt data

## Assertions vs Exceptions

- **Assertions**: For programmer errors, debugging
- **Exceptions**: For runtime errors, user input

\`\`\`python
# Assertion: should never happen if code is correct
assert len(items) > 0, "Bug: items should not be empty here"

# Exception: could happen in normal use
if user_input == "":
    raise ValueError("Please enter a value")
\`\`\``,
      codeExamples: JSON.stringify([
        {
          id: "basic-assert",
          title: "Basic Assertions",
          code: `def calculate_average(numbers):
    assert len(numbers) > 0, "Cannot average empty list"
    return sum(numbers) / len(numbers)

# Works fine
print(calculate_average([1, 2, 3, 4, 5]))

# Uncomment to see assertion fail:
# print(calculate_average([]))`,
          description: "Assert precondition",
        },
        {
          id: "pre-post-conditions",
          title: "Pre and Postconditions",
          code: `def factorial(n):
    # Precondition
    assert isinstance(n, int), "n must be an integer"
    assert n >= 0, "n must be non-negative"
    
    # Calculate
    if n <= 1:
        result = 1
    else:
        result = n * factorial(n - 1)
    
    # Postcondition
    assert result >= 1, "Factorial must be positive"
    return result

print(f"5! = {factorial(5)}")
print(f"0! = {factorial(0)}")`,
          description: "Check before and after",
        },
        {
          id: "defensive-programming",
          title: "Defensive Programming",
          code: `def transfer_money(from_account, to_account, amount):
    # Defensive checks
    assert amount > 0, "Amount must be positive"
    assert from_account != to_account, "Cannot transfer to same account"
    
    # Check sufficient funds
    balance = get_balance(from_account)
    assert balance >= amount, f"Insufficient funds: {balance} < {amount}"
    
    # Perform transfer (simulated)
    print(f"Transferring \\${amount}")
    return True

def get_balance(account):
    return 1000  # Simulated

transfer_money("A", "B", 500)`,
          description: "Multiple defensive checks",
        },
      ]),
      keyPoints: [
        "assert condition, message - stops if False",
        "Preconditions: check inputs at function start",
        "Postconditions: verify results before returning",
        "Fail fast: catch errors early",
        "Use assertions for bugs, exceptions for user errors",
      ],
      hardwareDemo: "Watch assertions check conditions. See program execution stop immediately when an assertion fails, with the error message displayed.",
      estimatedTime: 18,
      difficulty: "INTERMEDIATE",
      order: 8,
      isPublished: true,
    },
  });

  await prisma.exercise.createMany({
    skipDuplicates: true,
    data: [
      {
        lessonId: lesson6_3_1.id,
        number: 1,
        title: "Add Precondition",
        type: "CODE",
        difficulty: "BEGINNER",
        prompt: "Add an assertion to check that the list is not empty before finding the maximum.",
        starterCode: `def find_max(numbers):
    # Add assertion here
    assert len(numbers) > 0, "List cannot be empty"
    
    max_val = numbers[0]
    for n in numbers:
        if n > max_val:
            max_val = n
    return max_val

print(find_max([3, 1, 4, 1, 5]))`,
        solution: `def find_max(numbers):
    assert len(numbers) > 0, "List cannot be empty"
    
    max_val = numbers[0]
    for n in numbers:
        if n > max_val:
            max_val = n
    return max_val

print(find_max([3, 1, 4, 1, 5]))`,
        testCases: JSON.stringify([
          { input: "", expectedOutput: "5", description: "Returns max value" },
        ]),
        hints: ["Check len(numbers) > 0", "Add error message", "Assertion at start of function"],
        xpReward: 15,
        order: 1,
      },
      {
        lessonId: lesson6_3_1.id,
        number: 2,
        title: "Multiple Assertions",
        type: "CODE",
        difficulty: "INTERMEDIATE",
        prompt: "Add assertions to check: 1) rate is between 0 and 1, 2) years is positive.",
        starterCode: `def compound_interest(principal, rate, years):
    # Add assertions
    assert 0 <= rate <= 1, "Rate must be between 0 and 1"
    assert years > 0, "Years must be positive"
    
    return principal * (1 + rate) ** years

print(compound_interest(1000, 0.05, 10))`,
        solution: `def compound_interest(principal, rate, years):
    assert 0 <= rate <= 1, "Rate must be between 0 and 1"
    assert years > 0, "Years must be positive"
    
    return principal * (1 + rate) ** years

print(compound_interest(1000, 0.05, 10))`,
        testCases: JSON.stringify([
          { input: "", expectedOutput: "1628.894626777442", description: "Calculates compound interest" },
        ]),
        hints: ["0 <= rate <= 1 checks range", "years > 0 checks positive", "Both should have messages"],
        xpReward: 20,
        order: 2,
      },
      {
        lessonId: lesson6_3_1.id,
        number: 3,
        title: "Postcondition",
        type: "CODE",
        difficulty: "INTERMEDIATE",
        prompt: "Add a postcondition assertion to verify the result is never negative.",
        starterCode: `def absolute_difference(a, b):
    result = abs(a - b)
    # Add postcondition: result should be >= 0
    assert result >= 0, "Result cannot be negative"
    return result

print(absolute_difference(10, 3))
print(absolute_difference(3, 10))`,
        solution: `def absolute_difference(a, b):
    result = abs(a - b)
    assert result >= 0, "Result cannot be negative"
    return result

print(absolute_difference(10, 3))
print(absolute_difference(3, 10))`,
        testCases: JSON.stringify([
          { input: "", expectedOutput: "7\n7", description: "Both return positive" },
        ]),
        hints: ["Postcondition checks the result", "assert result >= 0", "Placed after calculation, before return"],
        xpReward: 20,
        order: 3,
      },
    ],
  });

