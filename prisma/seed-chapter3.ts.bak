print("-" * 40)

guess = (low + high) / 2
iteration = 1

while abs(guess**2 - x) >= epsilon:
    direction = "↑" if guess**2 < x else "↓"
    print(f"{iteration}: [{low:.3f}, {high:.3f}] → {guess:.3f}² = {guess**2:.3f} {direction}")
    
    if guess**2 < x:
        low = guess
    else:
        high = guess
    guess = (low + high) / 2
    iteration += 1

print(f"\\nResult: √{x} ≈ {guess:.4f}")`,
          description: "See how the search space shrinks",
        },
      ]),
