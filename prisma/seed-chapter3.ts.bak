epsilon = 0.01

for step in [0.1, 0.01, 0.001]:
    guess = 0
    count = 0
    
    while abs(guess**2 - x) >= epsilon and guess <= x:
        guess += step
        count += 1
    
    error = abs(guess**2 - x)
    print(f"step={step}: guess={guess:.3f}, error={error:.4f}, count={count}")`,
          description: "Smaller steps give better accuracy",
        },
      ]),
