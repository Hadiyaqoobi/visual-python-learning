for epsilon in [0.1, 0.01, 0.001]:
    guess = 0
    step = epsilon / 10
    count = 0
    
    while abs(guess**2 - x) >= epsilon:
        guess += step
        count += 1
    
    print(f"ε={epsilon}: √5 ≈ {guess:.4f} ({count} guesses)")`,
          description: "See how epsilon affects accuracy and speed",
        },
