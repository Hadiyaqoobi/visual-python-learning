iterations = 0

print(f"Finding √{x}")
while abs(guess**2 - x) >= epsilon:
    print(f"  guess = {guess:.4f}, guess² = {guess**2:.4f}")
    guess = (guess + x/guess) / 2
    iterations += 1

print(f"\\nResult: √{x} ≈ {guess:.4f}")
print(f"Iterations: {iterations}")`,
          description: "Watch Newton-Raphson converge rapidly",
        },
        {
          id: "compare-all",
