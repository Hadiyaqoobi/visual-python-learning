tax_cents = price_cents * 10 // 100
total_cents = price_cents + tax_cents
print(f"Good total: ${total_cents / 100}")`,
          description: "Why to use integers for money",
        },
      ]),
      keyPoints: [
        "Floats have limited precision (~15-17 digits)",
