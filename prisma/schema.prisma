generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH TABLES ====================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String?
  avatar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations
  sessions       Session[]
  lessonProgress LessonProgress[]
  exerciseAttempts ExerciseAttempt[]
  achievements   UserAchievement[]
  projectProgress UserProjectProgress[]
  milestoneSubmissions MilestoneSubmission[]
  
  // Gamification
  totalXp        Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveAt   DateTime?

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ==================== CURRICULUM TABLES ====================

model Chapter {
  id          String    @id @default(cuid())
  number      Int       @unique
  title       String
  description String
  objectives  String[]
  imageUrl    String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  sections    Section[]

  @@index([number])
}

model Section {
  id          String    @id @default(cuid())
  chapterId   String
  number      Float
  title       String
  description String?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([chapterId, number])
  @@index([chapterId])
  @@index([order])
}

model Lesson {
  id              String    @id @default(cuid())
  sectionId       String
  number          Float
  title           String
  slug            String    @unique
  objectives      String[]
  content         String
  codeExamples    Json
  keyPoints       String[]
  hardwareDemo    String?
  estimatedTime   Int       @default(15)
  difficulty      Difficulty @default(BEGINNER)
  order           Int
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  section         Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
  lessonProgress  LessonProgress[]

  @@unique([sectionId, number])
  @@index([sectionId])
  @@index([slug])
  @@index([order])
}

model Exercise {
  id            String       @id @default(cuid())
  lessonId      String
  number        Int
  title         String
  prompt        String
  type          ExerciseType @default(CODE)
  starterCode   String?
  solution      String?
  hints         String[]
  testCases     Json?
  xpReward      Int          @default(10)
  difficulty    Difficulty   @default(BEGINNER)
  order         Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts      ExerciseAttempt[]

  @@unique([lessonId, number])
  @@index([lessonId])
  @@index([order])
}

// ==================== PROGRESS TABLES ====================

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  timeSpent   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([status])
}

model ExerciseAttempt {
  id          String    @id @default(cuid())
  userId      String
  exerciseId  String
  code        String?
  response    String?
  isCorrect   Boolean   @default(false)
  xpEarned    Int       @default(0)
  feedback    String?
  attemptNumber Int     @default(1)
  createdAt   DateTime  @default(now())
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, exerciseId])
}

// ==================== GAMIFICATION TABLES ====================

model Achievement {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  description String
  iconUrl     String?
  xpReward    Int       @default(0)
  category    AchievementCategory @default(PROGRESS)
  createdAt   DateTime  @default(now())
  
  // Relations
  userAchievements UserAchievement[]

  @@index([code])
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  
  // Relations
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ==================== GUIDED PROJECTS ====================

model GuidedProject {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  description    String
  longDescription String?
  imageUrl       String?
  difficulty     Difficulty @default(BEGINNER)
  estimatedHours Int       @default(20)
  technologies   String[]
  prerequisites  String[]
  learningOutcomes String[]
  isPublished    Boolean   @default(false)
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations
  milestones     ProjectMilestone[]
  userProgress   UserProjectProgress[]
  submissions    MilestoneSubmission[]

  @@index([slug])
  @@index([order])
}

model ProjectMilestone {
  id             String    @id @default(cuid())
  projectId      String
  chapterNumber  Int
  title          String
  description    String
  objectives     String[]
  instructions   String
  starterCode    String?
  solutionCode   String?
  hints          String[]
  testInstructions String?
  order          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations
  project        GuidedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions    MilestoneSubmission[]

  @@unique([projectId, chapterNumber])
  @@index([projectId])
  @@index([order])
}

model UserProjectProgress {
  id               String    @id @default(cuid())
  userId           String
  projectId        String
  currentMilestone Int       @default(1)
  currentCode      String?
  status           ProgressStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          GuidedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model MilestoneSubmission {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  milestoneId     String
  chapterNumber   Int
  code            String?
  output          String?
  submittedAt     DateTime @default(now())
  
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         GuidedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
}

// ==================== ENUMS ====================

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseType {
  CODE
  MULTIPLE_CHOICE
  TEXT_RESPONSE
  FILL_BLANK
  FIX_BUG
  PREDICT_OUTPUT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AchievementCategory {
  PROGRESS
  STREAK
  MASTERY
  EXPLORATION
  SOCIAL
}
